#!/usr/bin/env bash
# Allrun -- launch the thermal-conduction validation cases in parallel, archiving
# each run into runs/<label>/ (which is exactly what validate.py reads back).
#
# How it works (and why it can run in parallel, unlike run_suite.sh):
#   * Each run gets its OWN directory runs/<label>/. We copy the case into it and
#     run there, so MFC's outputs (restart_data/, simulation.inp, ...) land in
#     runs/<label>/ directly -- no shared cases/ staging dir to clobber.
#   * The binary is content-addressed: grid/dt don't change it, so the 5 distinct
#     cases need only 5 builds. We build them once, sequentially (--dry-run builds
#     without running), then launch every run with --no-build in parallel.
#
# The 1D sweeps + 1d + 2d are cheap and run together. The two 500^3 3D cases are
# huge (~186 GB of checkpoints and hours each), so they run one-at-a-time after a
# free-disk check, and are OPT-IN: a bare ./Allrun does NOT run them.
#
#   ./Allrun                 # light set: conv sweeps + 1d + 2d, in parallel (default)
#   ./Allrun all             # light set, then the two 3D cases sequentially
#   ./Allrun conv            # just the convergence sweeps (convx + convt)
#   ./Allrun 1d 2d           # pick individual benchmarks
#   ./Allrun 3d              # just the heavy 3D pair (sequential, disk-guarded)
#   ./Allrun 3d-mode         # one 3D case
#
# Tunables (override via env):
#   MAXCORES=64   total MPI ranks kept in flight at once
#   RANKS_2D=16   ranks for the 2D run     RANKS_3D=32   ranks per 3D run
#   JOBS=8        build parallelism (-j)   MIN_FREE_3D_GB=200  skip a 3D run below this
#
# After it finishes, analyze with:  python3 validate.py   (runs every benchmark)
set -uo pipefail

EX="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"   # this example's directory
ROOT="$(cd "$EX/../.." && pwd)"                       # repo root (holds mfc.sh)
MFC="$ROOT/mfc.sh"
cd "$ROOT"
mkdir -p "$EX/runs"

MAXCORES=${MAXCORES:-64}
RANKS_2D=${RANKS_2D:-16}
RANKS_3D=${RANKS_3D:-32}
JOBS=${JOBS:-8}
MIN_FREE_3D_GB=${MIN_FREE_3D_GB:-200}

# Which labels make up each group. The light set runs in parallel; the 3D pair
# runs sequentially.
CONVX_LABELS=(convx_32 convx_64 convx_128 convx_256 convx_512)
CONVT_LABELS=(convt_256 convt_512 convt_1024 convt_2048 convt_4096)
LIGHT_LABELS=("${CONVX_LABELS[@]}" "${CONVT_LABELS[@]}" 1d 2d_mode)
SEQ3D_LABELS=(3d_mode 3d_hotspot)

# Temporal sweep: hold the final time t* fixed, vary the step count -> dt = t*/N.
# Same recipe case_conv.py expects via CONV_DT/CONV_NSTEPS.
declare -A CONVT_DT
TSTAR=$(python3 -c "import math; print(repr(0.3/(0.05*(2*math.pi)**2)))")
for ns in 256 512 1024 2048 4096; do
    CONVT_DT[$ns]=$(python3 -c "print(repr($TSTAR/$ns))")
done

# label -> "casefile ranks kind [env KEY=VAL ...]"
spec_for() {
    case "$1" in
        convx_*) echo "case_conv.py 1 light CONV_N=${1#convx_}" ;;
        convt_*) local ns=${1#convt_}; echo "case_conv.py 1 light CONV_N=32 CONV_DT=${CONVT_DT[$ns]} CONV_NSTEPS=$ns" ;;
        1d)         echo "case_1d.py 1 light" ;;
        2d_mode)    echo "case_2d_mode.py $RANKS_2D light" ;;
        3d_mode)    echo "case_3d_mode.py $RANKS_3D seq3d" ;;
        3d_hotspot) echo "case_3d_hotspot.py $RANKS_3D seq3d" ;;
        *) echo "" ;;
    esac
}

# Expand a user selector token (group name or exact label) to its labels.
expand_selector() {
    case "$1" in
        all)                   echo "${LIGHT_LABELS[@]} ${SEQ3D_LABELS[@]}" ;;
        light)                 echo "${LIGHT_LABELS[@]}" ;;
        conv)                  echo "${CONVX_LABELS[@]} ${CONVT_LABELS[@]}" ;;
        convx)                 echo "${CONVX_LABELS[@]}" ;;
        convt)                 echo "${CONVT_LABELS[@]}" ;;
        3d)                    echo "3d_mode 3d_hotspot" ;;
        2d)                    echo "2d_mode" ;;
        3d-mode)               echo "3d_mode" ;;
        3d-hotspot)            echo "3d_hotspot" ;;
        *)                     echo "$1" ;;   # assume it's an exact label
    esac
}

# Build the selected label list (default: light set; 3D is opt-in).
SELECTORS=("$@")
[ ${#SELECTORS[@]} -eq 0 ] && SELECTORS=(light)
SELECTED=()
for sel in "${SELECTORS[@]}"; do
    for lbl in $(expand_selector "$sel"); do
        [ -n "$(spec_for "$lbl")" ] || { echo "unknown case '$lbl' (from '$sel')"; exit 1; }
        # de-dup while preserving order
        case " ${SELECTED[*]-} " in *" $lbl "*) ;; *) SELECTED+=("$lbl") ;; esac
    done
done

# Run one case in its own directory. Sets runs/<label>/STATUS to OK or FAIL.
run_one() {  # <label>
    local label=$1
    local casef ranks _kind env
    read -r casef ranks _kind env <<<"$(spec_for "$label")"
    local envv; read -r -a envv <<<"$env"   # remaining "KEY=VAL ..." tokens
    local dir="$EX/runs/$label"
    rm -rf "$dir"; mkdir -p "$dir"
    cp "$EX/cases/$casef" "$dir/case.py"
    echo ">>> start $label  ($casef, n=$ranks)"
    if env "${envv[@]}" "$MFC" run "$dir/case.py" --no-build -t pre_process simulation \
            -n "$ranks" >"$dir/run.log" 2>&1; then
        echo OK >"$dir/STATUS";  echo "<<< done  $label"
    else
        echo FAIL >"$dir/STATUS"; echo "!!! FAIL  $label  (see runs/$label/run.log)"
    fi
}

# Budget-gated parallel launch: block until <ranks> cores are free, then go.
declare -a P_PID P_COST
inflight=0
gate() {  # <cores-needed>
    local need=$1
    while (( inflight + need > MAXCORES )); do
        wait -n
        local np=() nc=() i
        for i in "${!P_PID[@]}"; do
            if kill -0 "${P_PID[i]}" 2>/dev/null; then
                np+=("${P_PID[i]}"); nc+=("${P_COST[i]}")
            else
                inflight=$(( inflight - P_COST[i] ))
            fi
        done
        P_PID=("${np[@]}"); P_COST=("${nc[@]}")
    done
}

# Split selection into the parallel pool and the sequential 3D queue.
POOL=(); QUEUE3D=()
for lbl in "${SELECTED[@]}"; do
    read -r _c _r kind _e <<<"$(spec_for "$lbl")"
    if [ "$kind" = seq3d ]; then QUEUE3D+=("$lbl"); else POOL+=("$lbl"); fi
done

# Phase 1: build each distinct binary once, sequentially (--dry-run = build, no run).
declare -A SEEN_CASE
echo "=== building $(echo "${SELECTED[@]}" | wc -w) run(s) -> distinct binaries ==="
for lbl in "${SELECTED[@]}"; do
    read -r casef _r _k _e <<<"$(spec_for "$lbl")"
    [ -n "${SEEN_CASE[$casef]-}" ] && continue
    SEEN_CASE[$casef]=1
    echo ">>> [build] $casef"
    "$MFC" run "$EX/cases/$casef" --dry-run -t pre_process simulation -j "$JOBS" \
        || { echo "!!! build failed for $casef"; exit 1; }
done

# Phase 2a: the cheap cases, in parallel under the core budget.
if [ ${#POOL[@]} -gt 0 ]; then
    echo "=== running ${#POOL[@]} case(s) in parallel (cap ${MAXCORES} ranks) ==="
    for lbl in "${POOL[@]}"; do
        read -r _c ranks _k _e <<<"$(spec_for "$lbl")"
        gate "$ranks"
        run_one "$lbl" &
        P_PID+=("$!"); P_COST+=("$ranks"); inflight=$(( inflight + ranks ))
    done
    wait
fi

# Phase 2b: the heavy 3D cases, one at a time, each gated on free disk.
for lbl in "${QUEUE3D[@]}"; do
    free_gb=$(df -BG --output=avail "$EX/runs" | tail -1 | tr -dc '0-9')
    if (( free_gb < MIN_FREE_3D_GB )); then
        echo "!!! SKIP $lbl: only ${free_gb}G free on runs/ (need >=${MIN_FREE_3D_GB}G)"
        mkdir -p "$EX/runs/$lbl"; echo "SKIP(disk)" >"$EX/runs/$lbl/STATUS"
        continue
    fi
    echo "=== running $lbl (3D, ${free_gb}G free) ==="
    run_one "$lbl"
done

echo "=== summary ==="
for lbl in "${SELECTED[@]}"; do
    printf "  %-12s %s\n" "$lbl" "$(cat "$EX/runs/$lbl/STATUS" 2>/dev/null || echo MISSING)"
done
echo "next: python3 $EX/validate.py   (analyzes runs/ and writes figures + summary.json)"
