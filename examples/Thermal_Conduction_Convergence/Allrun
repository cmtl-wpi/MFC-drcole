#!/usr/bin/env bash
# Allrun -- launch the conduction convergence sweeps, archiving each into runs/<label>/
# (exactly what validate.py reads back).
#
#   spatial   convx_{32,64,128,256,512}     CONV_N=<N>; error vs the exact mode at fixed t*
#   temporal  convt_{256,512,1024,2048,4096} CONV_N=32, CONV_DT=t*/ns; error vs the tiny-dt run
#
# Every run gets its OWN runs/<label>/ dir (case copied in, run there), so MFC's
# outputs land per-label with no shared staging to clobber. The binary is
# content-addressed -- grid/dt don't change it -- so all 10 runs share ONE build:
# we build once (--dry-run builds without running), then launch with --no-build in
# parallel under a core budget. All runs are 1D, 1 rank each.
#
#   ./Allrun            # both sweeps (default)
#   ./Allrun spatial    # just the grid sweep
#   ./Allrun temporal   # just the time-step sweep
#
# Tunables (override via env):  MAXJOBS=16  concurrent runs   JOBS=8  build parallelism (-j)
#
# After it finishes:  python3 validate.py   (writes figures/ + summary.json)
set -uo pipefail

EX="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"  # this example's directory
ROOT="$(cd "$EX/../.." && pwd)"                      # repo root (holds mfc.sh)
MFC="$ROOT/mfc.sh"
cd "$ROOT"
mkdir -p "$EX/runs"

MAXJOBS=${MAXJOBS:-16}
JOBS=${JOBS:-8}

CONVX_N=(32 64 128 256 512)
CONVT_NS=(256 512 1024 2048 4096)

# Temporal sweep holds the final time t* fixed and varies the step count: dt = t*/ns.
TSTAR=$(python3 -c "import math; print(repr(0.3/(0.05*(2*math.pi)**2)))")

# label -> "ENV ..." passed to case.py at generation time.
env_for() {
    case "$1" in
        convx_*) echo "CONV_N=${1#convx_}" ;;
        convt_*) local ns=${1#convt_}; echo "CONV_N=32 CONV_NSTEPS=$ns CONV_DT=$(python3 -c "print(repr($TSTAR/$ns))")" ;;
        *) echo "" ;;
    esac
}

# Expand a selector to its labels.
expand() {
    case "$1" in
        both|"")  for N in "${CONVX_N[@]}"; do echo "convx_$N"; done; for ns in "${CONVT_NS[@]}"; do echo "convt_$ns"; done ;;
        spatial)  for N in "${CONVX_N[@]}"; do echo "convx_$N"; done ;;
        temporal) for ns in "${CONVT_NS[@]}"; do echo "convt_$ns"; done ;;
        *)        echo "$1" ;;
    esac
}

SELECTORS=("$@"); [ ${#SELECTORS[@]} -eq 0 ] && SELECTORS=(both)
SELECTED=()
for sel in "${SELECTORS[@]}"; do
    for lbl in $(expand "$sel"); do
        [ -n "$(env_for "$lbl")" ] || { echo "unknown label '$lbl' (from '$sel')"; exit 1; }
        case " ${SELECTED[*]-} " in *" $lbl "*) ;; *) SELECTED+=("$lbl") ;; esac
    done
done

# Phase 1: build the single binary once (--dry-run = build, no run).
echo "=== building case.py -> one binary ==="
"$MFC" run "$EX/case.py" --dry-run -t pre_process simulation -j "$JOBS" \
    || { echo "!!! build failed"; exit 1; }

# Phase 2: launch every run in its own dir, capped at MAXJOBS concurrent.
run_one() {  # <label>
    local label=$1 dir="$EX/runs/$label"
    rm -rf "$dir"; mkdir -p "$dir"
    cp "$EX/case.py" "$dir/case.py"
    if env $(env_for "$label") "$MFC" run "$dir/case.py" --no-build -t pre_process simulation -n 1 >"$dir/run.log" 2>&1; then
        echo OK >"$dir/STATUS"; echo "<<< done  $label"
    else
        echo FAIL >"$dir/STATUS"; echo "!!! FAIL  $label  (see runs/$label/run.log)"
    fi
}

echo "=== running ${#SELECTED[@]} sweep run(s), cap ${MAXJOBS} concurrent ==="
for lbl in "${SELECTED[@]}"; do
    while (( $(jobs -rp | wc -l) >= MAXJOBS )); do wait -n; done
    echo ">>> start $lbl ($(env_for "$lbl"))"
    run_one "$lbl" &
done
wait

echo "=== summary ==="
for lbl in "${SELECTED[@]}"; do
    printf "  %-12s %s\n" "$lbl" "$(cat "$EX/runs/$lbl/STATUS" 2>/dev/null || echo MISSING)"
done
echo "next: python3 $EX/validate.py"
